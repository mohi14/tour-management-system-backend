<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tour Management System API</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Segoe UI", sans-serif;
            background: linear-gradient(135deg, #0f172a, #1e293b);
            color: #fff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            width: 100%;
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            box-shadow: 0 15px 40px rgba(0,0,0,0.3);
        }

        h1 {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #cbd5e1;
            margin-bottom: 30px;
        }

        .badge {
            display: inline-block;
            background: #10b981;
            padding: 8px 18px;
            border-radius: 30px;
            font-weight: 600;
            margin-bottom: 25px;
        }

        .description {
            color: #e2e8f0;
            line-height: 1.8;
            margin-bottom: 40px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .card {
            background: rgba(255,255,255,0.08);
            padding: 20px;
            border-radius: 15px;
            transition: 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            background: rgba(255,255,255,0.12);
        }

        .card h3 {
            margin-bottom: 10px;
            color: #38bdf8;
        }

        .card p {
            color: #cbd5e1;
            font-size: 14px;
        }

        .footer {
            margin-top: 40px;
            color: #94a3b8;
            font-size: 14px;
        }

        a {
            color: #38bdf8;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        code {
            color: #facc15;
        }
    </style>
</head>
<body>

<div class="container">

    <div class="badge">
        API Status: Online ✅
    </div>

    <h1>🌍 Tour Management System</h1>

    <p class="subtitle">
        Backend API Service
    </p>

    <p class="description">
        Welcome to the Tour Management System API.
        This backend provides secure authentication, tour booking,
        user management, payment processing, reviews, and admin controls.
    </p>

    <div class="cards">

        <div class="card">
            <h3>Authentication</h3>
            <p>
                JWT-based authentication and role-based authorization.
            </p>
        </div>

        <div class="card">
            <h3>Tour Management</h3>
            <p>
                Create, update, search, and manage tour packages.
            </p>
        </div>

        <div class="card">
            <h3>Bookings</h3>
            <p>
                Manage tour reservations and booking history.
            </p>
        </div>

        <div class="card">
            <h3>Documentation</h3>
            <p>
                Access API documentation and endpoint references.
            </p>
        </div>

    </div>

    <div class="footer">
        <p>
            API Version: <code>v1.0.0</code>
        </p>

        <p style="margin-top:10px;">
            Documentation:
            <a href="/api-docs">/api-docs</a>
        </p>

        <p style="margin-top:10px;">
            © <%= new Date().getFullYear() %> Tour Management System
        </p>
    </div>

</div>

</body>
</html>

